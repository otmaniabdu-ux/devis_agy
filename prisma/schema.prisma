// El Mouhssinouen Tours — OmraVIP Quotes
// Schéma basé sur PROMPT_AGENT_OmraVIP.md
// Toute valeur monétaire est stockée en String (decimal TEXT) — jamais REAL/Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Authentification (rôle unique "agent d'agence") ---
model Utilisateur {
  id             String    @id @default(cuid())
  nomUtilisateur String    @unique
  passwordHash   String    // bcrypt (bcryptjs) — jamais de hash maison
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
}

model Session {
  id            String      @id @default(cuid())
  tokenHash     String      @unique // SHA-256 du token — le token brut n'est jamais stocké
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
}

// --- Paramètres globaux de l'agence (singleton) ---
model ParametresAgence {
  id              String   @id @default("default")
  nomFr           String   @default("El Mouhssinoune Tours")
  nomAr           String   @default("المحسنون للسياحة")
  sloganFr        String?
  sloganAr        String?
  adresse         String?
  telephone       String?
  email           String?
  rc              String?  // Registre de commerce
  if              String?  // Identifiant fiscal
  art             String?  // Article d'imposition
  capital         String?
  logoPath        String?
  primaryColor    String   @default("#CC1A1A")
  darkColor       String   @default("#0A1628")
  goldColor       String   @default("#C4A152")
  royalColor      String   @default("#1B3A6B")
  ivoryColor      String   @default("#F7F5F0")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Taux de change par défaut (modifiables dans Paramètres) ---
// À la création d'un devis, ces taux sont COPIÉS dans la ligne Devis (verrouillage).
model TauxChange {
  id        String   @id @default(cuid())
  code      String   @unique  // SAR, USD, EUR
  libelleFr String
  libelleAr String
  tauxDzd   String             // montant en DZD pour 1 unité, en string decimal
  updatedAt DateTime @updatedAt
}

// --- Compteur de numérotation mensuel DEVIS-YYYY-MM-NNN ---
model CompteurNumerotation {
  cle             String   @id  // ex: "DEVIS-2026-07"
  dernierNumero   Int      @default(0)
  updatedAt       DateTime @updatedAt
}

// --- Clients ---
model Client {
  id           String   @id @default(cuid())
  type         String   @default("particulier")  // particulier | societe
  nom          String
  prenom       String?
  raisonSociale String?
  telephone    String?
  email        String?
  adresse      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  devis        Devis[]
  factures     Facture[]
}

// --- Devis ---
model Devis {
  id              String   @id @default(cuid())
  numero          String   @unique  // DEVIS-YYYY-MM-NNN
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])

  // Dates du voyage
  dateDepart      DateTime
  dateRetour      DateTime

  // Taux de change VERROUILLÉS à la création (jamais modifiés a posteriori)
  tauxSarDzd      String   // ex: "35.50"
  tauxUsdDzd      String
  tauxEurDzd      String

  // Visa
  visaType        String   @default("omra_standard")  // omra_standard | touristique | hadj
  visaPrixUnit    String   @default("0")              // par passager, en SAR
  visaDevise      String   @default("SAR")

  // Assurance médicale
  assurancePrixUnit String @default("0")  // par passager, en SAR
  assuranceDevise   String @default("SAR")

  // Frais ONPO
  fraisOnpoPrixUnit String @default("5000") // par passager, en DZD
  fraisOnpoDevise   String @default("DZD")

  // Marge agence
  margeType       String   @default("pourcentage")  // pourcentage | montant_fixe
  margeValeur     String   @default("0")             // % ou montant DZD

  // Totaux calculés (cout net DZD, prix vente DZD, marge DZD)
  coutNetDzd      String   @default("0")
  prixVenteDzd    String   @default("0")
  margeMontantDzd String   @default("0")

  statut          String   @default("brouillon")  // brouillon | envoye | accepte | refuse | archive
  notesInternes   String?
  notesClient     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  passagers       Passager[]
  segmentsVol     SegmentVol[]
  hebergements    Hebergement[]
  transferts      Transfert[]
  trainsHaramain  TrainHaramain[]
  prestationsVip  PrestationVIP[]

  campsMashair    CampMashair[]
  transportsMashair TransportMashair[]
  facture         Facture?

  @@index([clientId])
  @@index([numero])
  @@index([statut])
}

// --- Passagers ---
model Passager {
  id              String   @id @default(cuid())
  devisId         String
  devis           Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  categorie       String   // adulte | enfant_avec_lit | enfant_sans_lit | bebe
  nom             String
  prenom          String
  dateNaissance   DateTime?
  passeportNumero String?
  passeportExpiration DateTime?
  createdAt       DateTime @default(now())
  @@index([devisId])
}

// --- Segments de vol ---
model SegmentVol {
  id                String   @id @default(cuid())
  devisId           String
  devis             Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  ordre             Int      @default(0)
  compagnieId       String?
  compagnie         CatalogueCompagnie? @relation(fields: [compagnieId], references: [id])
  origine           String
  destination       String
  dateVol           DateTime
  classe            String   @default("economique")  // economique | affaires | premiere
  origineRetour     String?
  destinationRetour String?
  dateVolRetour     DateTime?
  classeRetour      String?  @default("economique")
  prixAdulte        String   @default("0")  // devise source
  prixEnfant        String   @default("0")
  prixBebe          String   @default("0")
  devise            String   @default("SAR")
  createdAt         DateTime @default(now())
  @@index([devisId])
}

// --- Hébergements ---
model Hebergement {
  id              String   @id @default(cuid())
  devisId         String
  devis           Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  ville           String   // Makkah | Medine
  hotelId         String?
  hotel           CatalogueHotel? @relation(fields: [hotelId], references: [id])
  hotelNom        String   // snapshot
  typeChambre     String   @default("double")  // single | double | triple | quadruple
  formuleRepas    String   @default("demi_pension")  // petit_dejeuner | demi_pension | pension_complete
  vue             String   @default("city")  // kaaba | haram | city
  dateCheckin     DateTime
  dateCheckout    DateTime
  nbNuitees       Int      @default(0)  // calculé côté serveur
  prixNuitChambre String   @default("0")  // prix par nuit par chambre, devise source
  nbChambres      Int      @default(1)
  devise          String   @default("SAR")
  createdAt       DateTime @default(now())
  @@index([devisId])
}

// --- Transferts terrestres ---
model Transfert {
  id              String   @id @default(cuid())
  devisId         String
  devis           Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  ordre           Int      @default(0)
  trajet          String   // ex: "Aéroport Djeddah → Hôtel Makkah"
  typeVehicule    String   // GMC_Yukon | Mercedes_Classe_E | Bus_VIP_prive
  prix            String   @default("0")  // par véhicule
  devise          String   @default("SAR")
  obligatoire     Boolean  @default(true)
  createdAt       DateTime @default(now())
  @@index([devisId])
}

// --- Train Haramain ---
model TrainHaramain {
  id              String   @id @default(cuid())
  devisId         String
  devis           Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  trajet          String   // ex: "Makkah → Médine"
  classe          String   @default("economique")  // economique | business
  dateTrain       DateTime
  prixAdulte      String   @default("0")
  prixEnfant      String   @default("0")
  devise          String   @default("SAR")
  createdAt       DateTime @default(now())
  @@index([devisId])
}

// --- Prestations VIP libres ---
model PrestationVIP {
  id              String   @id @default(cuid())
  devisId         String
  devis           Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  type            String   // ziyarate | lounge | fast_track | bagagerie | zamzam | autre
  descriptionFr   String
  descriptionAr   String?
  prix            String   @default("0")  // prix total prestation
  devise          String   @default("SAR")
  createdAt       DateTime @default(now())
  @@index([devisId])
}

// --- Catalogue des hôtels ---
model CatalogueHotel {
  id              String   @id @default(cuid())
  ville           String   // Makkah | Medine
  nom             String
  nomAr           String?
  etoiles         Int      @default(4)
  distanceHaram   Int?     // en mètres
  prixSingleSar   String   @default("0")
  prixDoubleSar   String   @default("0")
  prixTripleSar   String   @default("0")
  prixQuadrupleSar String  @default("0")
  devise          String   @default("SAR")
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hebergements    Hebergement[]
}

// --- Catalogue des compagnies aériennes ---
model CatalogueCompagnie {
  id              String   @id @default(cuid())
  nom             String
  codeIata        String?
  logoPath        String?
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  segments        SegmentVol[]
}

// --- Camps Mashair (Hadj VIP) ---
model CampMashair {
  id              String   @id @default(cuid())
  devisId         String
  devis           Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  nomCamp         String
  typeTente       String
  restauration    String
  prixAdulte      String   @default("0")
  prixEnfant      String   @default("0")
  devise          String   @default("SAR")
  createdAt       DateTime @default(now())
  @@index([devisId])
}

// --- Transports Mashair (Hadj VIP) ---
model TransportMashair {
  id              String   @id @default(cuid())
  devisId         String
  devis           Devis    @relation(fields: [devisId], references: [id], onDelete: Cascade)
  typeVehicule    String
  trajet          String
  prix            String   @default("0")
  typePrix        String   @default("forfait") // forfait ou par_passager
  devise          String   @default("SAR")
  createdAt       DateTime @default(now())
  @@index([devisId])
}


// --- Journal d'Audit (Phase 5) ---
model AuditEvent {
  id        String   @id @default(cuid())
  action    String   // ex: 'CREATE_DEVIS', 'UPDATE_DEVIS', 'GENERATE_PDF', 'DELETE_CLIENT'
  entite    String   // 'Devis', 'Client', 'Parametres'
  entiteId  String?  // ID de l'entité concernée
  details   String?  // JSON avec l'ancien/nouveau state ou métadonnées
  createdAt DateTime @default(now())
}

// --- Factures (générées à partir d'un devis confirmé) ---
model Facture {
  id              String      @id @default(cuid())
  numero          String      @unique // FACT-YYYY-MM-NNN
  devisId         String      @unique // 1 devis confirmé = 1 facture
  devis           Devis       @relation(fields: [devisId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id])

  dateEmission    DateTime    @default(now())
  dateEcheance    DateTime?

  montantTotalDzd String      // prixVenteDzd du devis (en decimal TEXT)
  montantPayeDzd  String      @default("0") // Somme des versements
  resteAPayerDzd  String      // montantTotalDzd - montantPayeDzd

  statut          String      @default("non_payee") // non_payee | partiellement_payee | payee | annulee
  notes           String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  versements      Versement[]

  @@index([clientId])
  @@index([devisId])
  @@index([numero])
  @@index([statut])
}

// --- Versements / Règlements des clients ---
model Versement {
  id            String   @id @default(cuid())
  factureId     String
  facture       Facture  @relation(fields: [factureId], references: [id], onDelete: Cascade)

  numeroRecu    String   @unique // RECU-YYYY-MM-NNN
  dateVersement DateTime @default(now())
  montantDzd    String   // Decimal string DZD
  modePaiement  String   @default("especes") // especes | virement | cheque | versement_bancaire
  reference     String?  // Numéro de chèque, transaction, reçu manuel
  recuPar       String?  // Agent ayant encaissé
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([factureId])
  @@index([numeroRecu])
}

