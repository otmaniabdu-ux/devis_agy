{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmraVIP",
  "version": "0.1.0",
  "identifier": "com.elmouhssinoune.omravip",
  "build": {
    "frontendDist": "../src-tauri/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "bun run scripts/build-tauri.ts"
  },
  "app": {
    "windows": [
      {
        "title": "El Mouhssinoune Tours",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* https://localhost:*; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/server"
    ],
    "resources": {
      "../.next/standalone": ".next/standalone",
      "../db": "db"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
